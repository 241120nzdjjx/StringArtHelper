page {
  min-height: 100%;
  background: #101016;
  color: #f5f5fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}

view, text, button, input, slider, switch, canvas, image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

.panel {
  background: #1d1d27;
  border: 1rpx solid #343444;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
}

.subtitle {
  color: #9d9dae;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 16rpx;
}

.primary, .secondary, .danger, .ghost {
  border-radius: 18rpx;
  font-size: 29rpx;
  line-height: 88rpx;
  height: 88rpx;
  margin: 14rpx 0 0;
}

.primary {
  color: #fff;
  background: #9769ff;
}

.secondary {
  color: #f5f5fa;
  background: #262632;
  border: 1rpx solid #444457;
}

.danger {
  color: #fff;
  background: #682c37;
}

.ghost {
  color: #cbb7ff;
  background: transparent;
  border: 1rpx solid #7655bd;
}

button[disabled] {
  opacity: .38;
}

.file-import-hint,
.file-export-hint {
  margin: 10rpx 8rpx 4rpx;
  color: #9d9dae;
  font-size: 22rpx;
  line-height: 1.55;
}

.preview-file-export-hint {
  margin-top: 14rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row > .grow {
  flex: 1;
}

.button-grid {
  display: grid;
  width: 100%;
  max-width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.button-grid button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding-left: 12rpx;
  padding-right: 12rpx;
  margin-top: 0;
  overflow: hidden;
  white-space: nowrap;
}

.input {
  height: 78rpx;
  padding: 0 22rpx;
  color: #fff;
  background: #262632;
  border: 1rpx solid #444457;
  border-radius: 16rpx;
}

.label {
  display: block;
  margin: 20rpx 0 8rpx;
  color: #d7d7e0;
  font-size: 27rpx;
}

.muted {
  color: #9d9dae;
}

.accent {
  color: #b99cff;
}

.center {
  text-align: center;
}

.divider {
  height: 1rpx;
  background: #3b3b4c;
  margin: 22rpx 0;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
