.reader-page {
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  background: #101016;
  overflow-x: hidden;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}

.reader-header {
  padding: 22rpx 28rpx 10rpx;
  text-align: center;
}

.reader-name {
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 650;
}

.number-stage {
  min-height: 230rpx;
  display: grid;
  grid-template-columns: 1fr 1.4fr 1fr;
  align-items: center;
  padding: 16rpx 28rpx;
}

.side-number, .current-number {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.number-label {
  color: #9d9dae;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.number-value {
  color: #b7b7c5;
  font-size: 70rpx;
  font-weight: 650;
}

.current-value {
  color: #fff;
  font-size: 112rpx;
  line-height: 1;
  font-weight: 800;
  text-shadow: 0 0 36rpx rgba(151,105,255,.45);
}

.reader-preview-canvas {
  display: block;
  border-radius: 0 0 18rpx 18rpx;
  overflow: hidden;
}

.reader-preview-fullbar {
  display: flex;
  align-items: center;
  min-height: 62rpx;
  color: #e9e0ff;
  background: #292337;
}

.preview-tool-button {
  width: 62rpx;
  min-width: 62rpx;
  height: 62rpx;
  padding: 0;
  margin: 0;
  border-radius: 0;
  border: 0;
  color: #fff;
  background: transparent;
  font-size: 28rpx;
  line-height: 62rpx;
}

.reader-preview-fullscreen {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  overflow-y: auto;
  padding: 18rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(10, 10, 15, .97);
}

.reader-preview-fullbar {
  width: 100%;
  padding-left: 22rpx;
  border-radius: 18rpx 18rpx 0 0;
}

.reader-preview-fullbar > .grow {
  flex: 1 1 0;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reader-preview-canvas.full {
  border-radius: 0;
}

.reader-preview-animation-controls {
  padding: 8rpx 20rpx 20rpx;
  border-radius: 0 0 18rpx 18rpx;
  background: #1d1d27;
}

.reader-preview-animation-controls .label {
  margin-top: 8rpx;
}

.reader-preview-number-stage {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr);
  align-items: end;
  gap: 6rpx;
  width: 100%;
  min-width: 0;
  padding: 12rpx 0 4rpx;
}

.reader-preview-number {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.reader-preview-number-label {
  width: 100%;
  overflow: hidden;
  color: #8f8d9c;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 18rpx;
}

.reader-preview-number-value {
  max-width: 100%;
  overflow: hidden;
  color: #aaa8b6;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reader-preview-number.current .reader-preview-number-label {
  color: #bda8ff;
}

.reader-preview-number.current .reader-preview-number-value {
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  text-shadow: 0 0 20rpx rgba(151, 105, 255, .48);
}

.reader-preview-step-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
  padding: 4rpx 0 8rpx;
  overflow: hidden;
}

.reader-preview-step-controls button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: calc(50% - 6rpx);
  height: 68rpx;
  margin: 0;
  padding: 0 10rpx;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 68rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reader-preview-step-count {
  width: 100%;
  padding-top: 10rpx;
  color: #d8d3e7;
  text-align: center;
  font-size: 22rpx;
  white-space: nowrap;
}

.reader-preview-jump-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(92rpx, .62fr);
  gap: 12rpx;
  width: 100%;
  min-width: 0;
  margin-bottom: 8rpx;
}

.reader-preview-jump-controls .input,
.reader-preview-jump-controls button {
  width: 100%;
  min-width: 0;
  height: 66rpx;
  margin: 0;
  box-sizing: border-box;
}

.reader-preview-jump-controls .input {
  padding: 0 14rpx;
  text-align: center;
}

.reader-preview-jump-controls button {
  padding: 0 8rpx;
  font-size: 23rpx;
  line-height: 66rpx;
}

.progress-wrap {
  padding: 0 30rpx 18rpx;
}

.reader-controls {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 22rpx 28rpx calc(58rpx + env(safe-area-inset-bottom));
  background: #1d1d27;
  border-radius: 28rpx 28rpx 0 0;
}

.button-grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.button-grid.three button {
  padding: 0 8rpx;
  font-size: 25rpx;
}

.jump-row {
  margin-top: 16rpx;
}

.jump-button {
  width: 160rpx;
  margin: 0;
}

.tts-note {
  margin: 8rpx 0 20rpx;
}
