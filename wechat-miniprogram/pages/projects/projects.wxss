.explain { color:#aaa9bb; font-size:24rpx; line-height:1.55; margin:14rpx 0 24rpx; }
.current-panel { margin-bottom:16rpx; }
.top-actions { margin-bottom:10rpx; }
.project-import-hint { margin-bottom:30rpx; }
.top-actions button { height:100rpx; line-height:1.25; padding:10rpx 12rpx; font-size:24rpx; white-space:normal; }
.group-title { font-size:29rpx; font-weight:650; margin:28rpx 4rpx 16rpx; }
.empty { border:1rpx dashed #444457; border-radius:20rpx; padding:34rpx; color:#858596; text-align:center; }
.project-card { display:flex; align-items:center; gap:18rpx; padding:18rpx; margin-bottom:14rpx; background:#1d1d27; border:1rpx solid #343444; border-radius:22rpx; }
.thumb { width:64rpx; height:64rpx; flex:0 0 64rpx; border-radius:12rpx; background:#fff; }
.placeholder { color:#222; background:#eee; display:flex; align-items:center; justify-content:center; font-size:36rpx; }
.card-body { flex:1; min-width:0; }
.name-row { display:flex; align-items:center; gap:10rpx; }
.project-name { font-size:29rpx; font-weight:650; }
.ellipsis { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.meta,.date { color:#8f8e9e; font-size:21rpx; line-height:1.55; }
.date { margin-top:3rpx; }
.current-tag { color:#d7c6ff; background:#583c91; border-radius:999rpx; padding:3rpx 11rpx; font-size:19rpx; }
.more { width:64rpx; min-width:64rpx; height:70rpx; line-height:58rpx; padding:0; margin:0; color:#ddd; background:transparent; font-size:42rpx; }
.overlay { position:fixed; z-index:30; inset:0; display:flex; align-items:flex-end; justify-content:center; padding:28rpx; background:rgba(0,0,0,.68); }
.sheet,.dialog { width:100%; max-width:680rpx; padding:24rpx; border:1rpx solid #46465a; border-radius:26rpx; background:#22222d; box-shadow:0 16rpx 60rpx rgba(0,0,0,.5); }
.dialog { align-self:center; }
.sheet-title { font-size:30rpx; font-weight:700; margin-bottom:18rpx; }
.sheet button { width:100%; height:76rpx; line-height:76rpx; margin:5rpx 0; color:#f2f2f8; background:#292936; font-size:27rpx; }
.sheet .danger-text { color:#ff8799; background:#33242b; }
.menu-file-export-hint { margin:10rpx 8rpx 14rpx; text-align:left; }
.dialog-buttons { margin-top:18rpx; }
.import-dialog .meta { margin:10rpx 0 18rpx; }
.import-dialog button { margin-top:12rpx; }
.warning { color:#f0c978; background:#352f23; border-radius:14rpx; padding:14rpx; margin:14rpx 0; font-size:23rpx; line-height:1.5; }
